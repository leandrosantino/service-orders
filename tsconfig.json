{
  "compilerOptions": {
    "jsx": "react",
    "target": "ES2021",
    //  "lib": [
    //     "ESNext",
    //     "DOM",
    //     "DOM.Iterable"
    //   ],
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": "./src",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "paths": {
      "@/*": [ "./*" ],
      "@view/*": [ "./view/*" ]
    }
  },
}
